{
  "name": "sipzone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test tests/*.test.ts",
    "test:rooms": "node tests/run-rooms.mjs",
    "pages:dev": "wrangler pages dev dist --port 8787",
    "pages:check": "wrangler pages functions build --outdir .wrangler/functions",
    "pages:types": "wrangler types --include-runtime=false functions/worker-configuration.d.ts",
    "rooms:dev": "wrangler dev -c workers/rooms/wrangler.jsonc --port 8788",
    "rooms:types": "wrangler types --include-runtime=false -c workers/rooms/wrangler.jsonc workers/rooms/worker-configuration.d.ts",
    "rooms:check": "wrangler deploy --dry-run --outdir .wrangler/rooms -c workers/rooms/wrangler.jsonc",
    "rooms:deploy": "wrangler deploy -c workers/rooms/wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
